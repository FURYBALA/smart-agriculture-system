# Copy this file to .env and fill in your own key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# IP address printed by irrigation_node.ino's Serial output on boot
IRRIGATION_NODE_HOST=192.168.1.50

# IP address printed by vision_node.ino's Serial output on boot
VISION_NODE_HOST=192.168.1.51
