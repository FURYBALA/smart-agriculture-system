# Copy this file to .env and fill in your own key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# IP address printed by irrigation_node.ino's Serial output on boot
IRRIGATION_NODE_HOST=192.168.1.50

# IP address printed by vision_node.ino's Serial output on boot
VISION_NODE_HOST=192.168.1.51

# Not read by any code in this app today -- the Diagnosis screen calls
# Gemini Vision directly from the phone and needs no backend. Listed
# here only as a reference for the deployed backend's real base URL,
# if you're extending the app to call it -- see backend/README.md and
# docs/DEPLOYMENT.md for the actual current deployment status/endpoint.
# BACKEND_API_URL=https://p17huf2s49.execute-api.ap-south-1.amazonaws.com/prod/
