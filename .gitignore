# ML dataset + Python
ml/data/raw/
__pycache__/
*.pyc
.venv/
venv/

# AWS SAM build output
backend/infrastructure/.aws-sam/
backend/infrastructure/samconfig.toml

# Pre-deploy step (see backend/README.md "Before deploying") copies the
# model here for packaging -- one tracked source of truth in ml/models/
# instead of two copies that can silently drift.
backend/lambda_functions/inference_handler/*.tflite

# arduino-cli --output-dir compile artifacts (.bin/.elf/.map) -- also
# what Wokwi's wokwi.toml points at locally; never committed
firmware/irrigation_node/build/
firmware/vision_node/build/

# wokwi-cli --serial-log-file output -- a real, useful debugging aid
# locally, but a run-specific artifact, not project source
firmware/**/wokwi-serial.log
firmware/**/*.wokwi-serial.log

# Generated by demo/generate_demo_payload.py -- regenerate with that
# script rather than tracking its output
demo/payload.json

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
